NODE_ENV=development
HOST=127.0.0.1
PORT=3000
FRONTEND_URL=http://localhost:5173

# Banco local executado pelo Docker Compose
MYSQL_DATABASE=lexis
MYSQL_USER=lexis_user
MYSQL_PASSWORD=lexis_dev_password
MYSQL_ROOT_PASSWORD=lexis_root_dev_password

DATABASE_URL=mysql://lexis_user:lexis_dev_password@127.0.0.1:3307/lexis
SHADOW_DATABASE_URL=mysql://lexis_user:lexis_dev_password@127.0.0.1:3307/lexis_shadow
TEST_DATABASE_URL=mysql://lexis_user:lexis_dev_password@127.0.0.1:3307/lexis_test

# Gere dois segredos hexadecimais diferentes, cada um com 128 caracteres
JWT_ACCESS_SECRET=SUBSTITUA_POR_UM_SEGREDO_HEXADECIMAL_DE_128_CARACTERES
JWT_REFRESH_SECRET=SUBSTITUA_POR_OUTRO_SEGREDO_HEXADECIMAL_DE_128_CARACTERES
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# OCR.space: cada desenvolvedor deve usar sua própria chave
OCR_SPACE_API_KEY=SUA_CHAVE_OCR_SPACE_AQUI
OCR_SPACE_API_URL=https://api.ocr.space/parse/image
OCR_SPACE_ENGINE=3
OCR_SPACE_LANGUAGE=por
OCR_TIMEOUT_MS=60000
OCR_MAX_FILE_SIZE_BYTES=1048576

# Google Gemini: cada desenvolvedor deve usar sua própria chave
GEMINI_API_KEY=SUA_CHAVE_GEMINI_AQUI
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=120000

# E-mail transacional (Resend)
# Em desenvolvimento, todo envio é redirecionado para EMAIL_DEMO_RECIPIENT.
# Com onboarding@resend.dev, use o mesmo e-mail cadastrado na conta Resend.
EMAIL_ENABLED=false
RESEND_API_KEY=SUA_CHAVE_RESEND_AQUI
RESEND_FROM="LÉXIS <onboarding@resend.dev>"
EMAIL_DEMO_RECIPIENT=SEU_EMAIL_REAL_AQUI
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_DELAY_MS=60000
EMAIL_BATCH_SIZE=10
